---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  math?: boolean;
  reading?: boolean;
  published?: Date;
}

const {
  title,
  description = "Sam McClenaghan — computer science at the University of Victoria. Writing about things I've built and what building them taught me.",
  math = false,
  reading = false,
  published,
} = Astro.props;

const siteName = "Sam McClenaghan";
const pageTitle = title ? `${title} — ${siteName}` : siteName;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("og.png", Astro.site);
const Masthead = title ? "span" : "h1";

const person = {
  "@type": "Person",
  name: siteName,
  url: Astro.site?.href,
  sameAs: [
    "https://github.com/sammcclenaghan",
    "https://www.linkedin.com/in/sam-mcclenaghan",
  ],
};
const jsonLd = published
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title,
      description,
      datePublished: published.toISOString().slice(0, 10),
      url: canonical.href,
      author: person,
    }
  : { "@context": "https://schema.org", ...person };

const links = [
  { href: "https://github.com/sammcclenaghan", label: "github" },
  { href: "/resume.pdf", label: "resume" },
  { href: "mailto:sam@aream.ca", label: "email" },
  { href: "https://www.linkedin.com/in/sam-mcclenaghan", label: "linkedin" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteName}
      href={new URL("rss.xml", Astro.site)}
    />
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#121212"
      media="(prefers-color-scheme: dark)"
    />

    <link
      rel="preload"
      href="/fonts/geist-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/geist-mono-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {math && <link rel="stylesheet" href="/katex.min.css" />}

    <meta property="og:type" content={published ? "article" : "website"} />
    {
      published && (
        <meta
          property="article:published_time"
          content={published.toISOString().slice(0, 10)}
        />
      )
    }
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${siteName} — ${canonical.host}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <div
      class:list={[
        "page mx-auto max-w-[44rem] pb-8",
        !reading && "page-rail",
      ]}
    >
      <header
        class:list={[
          "rail border-b border-ui1 pb-3",
          reading && "rail-seg",
        ]}
        style={reading ? "--seg-top: var(--page-top)" : undefined}
      >
        <span aria-hidden="true"></span>
        <a href="/" class="block w-fit">
          <Masthead
            class="block text-2xl font-semibold leading-tight tracking-[-0.02em]"
          >
            Sam McClenaghan
          </Masthead>
        </a>
      </header>

      <main class="pt-[var(--head-gap)]">
        <slot />
      </main>

      <footer class="rail border-t border-ui1 mt-16 pt-3">
        <span aria-hidden="true"></span>
        <div class="meta flex flex-wrap gap-x-4 gap-y-1">
          {
            links.map((item) => (
              <a
                href={item.href}
                data-link
                target={item.href.startsWith("http") ? "_blank" : undefined}
                rel={
                  item.href.startsWith("http")
                    ? "noopener noreferrer"
                    : undefined
                }
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </footer>
    </div>
  </body>
</html>
