---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Loads KaTeX stylesheet only on pages that actually contain math. */
  math?: boolean;
  /** Draws the rule under the name. The index turns this off because its
      lede carries the rule instead — name and lede read as one block there,
      which is the whole point. */
  divider?: boolean;
  /** Draws the continuous rail stroke. */
  rail?: boolean;
  /** Reading surface: the rail stroke spans the masthead and title only
      (see .rail-seg) instead of running the whole page. */
  reading?: boolean;
  /** Publish date. Presence is what marks a page as a post: it flips og:type
      to "article" and emits BlogPosting JSON-LD instead of the index's Person. */
  published?: Date;
}

const {
  title,
  description = "Sam McClenaghan — computer science at the University of Victoria. Writing about things I've built and what building them taught me.",
  math = false,
  divider = true,
  rail = true,
  reading = false,
  published,
} = Astro.props;

const siteName = "Sam McClenaghan";
const pageTitle = title ? `${title} — ${siteName}` : siteName;
const canonical = new URL(Astro.url.pathname, Astro.site);

// The name is the page's heading on the index, where nothing else outranks it,
// and a plain span on a post, where the article title is the h1. Rendering it
// as an h2 everywhere left the index with no h1 at all and made every post's
// outline open at h2 and then jump backwards to h1.
const Masthead = title ? "span" : "h1";

// Absolute, and it has to be: every scraper requires a fully-qualified URL for
// og:image and silently shows nothing for a root-relative one.
const ogImage = new URL("og.png", Astro.site);

// One JSON-LD block per page: BlogPosting on posts, Person everywhere else.
// Person carries sameAs so a name search can tie the site to the GitHub and
// LinkedIn profiles — that link is the whole reason the block exists.
const person = {
  "@type": "Person",
  name: siteName,
  url: Astro.site?.href,
  sameAs: [
    "https://github.com/sammcclenaghan",
    "https://www.linkedin.com/in/sam-mcclenaghan",
  ],
};
const jsonLd = published
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title,
      description,
      datePublished: published.toISOString().slice(0, 10),
      url: canonical.href,
      author: person,
    }
  : { "@context": "https://schema.org", ...person };

// No nav. One page has nowhere to navigate to, and everything that isn't
// this page is off-site — which belongs at the bottom, after the content,
// not above it competing for the first thing you see.
// Four labels, all one word. The address used to be its own label, which made
// it the longest item in the row and the only one that wasn't a noun for a
// destination — "email" matches github / resume / linkedin. The mailto is
// unchanged, so the address is still one click away.
//
// No rss link. The feed itself still builds and is still announced in <head>
// via <link rel="alternate">, which is how readers actually subscribe — so
// removing the visible link costs nothing and breaks nobody.
const links = [
  { href: "https://github.com/sammcclenaghan", label: "github" },
  { href: "/resume.pdf", label: "resume" },
  { href: "mailto:sam@aream.ca", label: "email" },
  { href: "https://www.linkedin.com/in/sam-mcclenaghan", label: "linkedin" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteName}
      href={new URL("rss.xml", Astro.site)}
    />
    <meta name="theme-color" content="#ffffff" />

    <!-- Fonts are the only blocking asset. Preloaded so they land with the
         first paint instead of swapping in after it. -->
    <link
      rel="preload"
      href="/fonts/geist-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/geist-mono-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {math && <link rel="stylesheet" href="/katex.min.css" />}

    <!-- Without og:image every share — LinkedIn, Slack, iMessage, Twitter —
         renders as a bare text row with no card, which reads as a broken link
         rather than a restrained one. The card is the site's own dark mode: blue
         label block, rail, real Geist. Source kept at src/og-card.html; re-render
         with the command in that file's comment if the name or line changes.
         summary_large_image is what makes Twitter use the wide card instead of
         cropping to a small square thumbnail. -->
    <meta property="og:type" content={published ? "article" : "website"} />
    {
      published && (
        <meta
          property="article:published_time"
          content={published.toISOString().slice(0, 10)}
        />
      )
    }
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${siteName} — ${canonical.host}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- The only script on the site. Runs before paint so there's no flash of
         the wrong theme.
         The localStorage read is gone along with the theme button: nothing
         writes that key any more, so keeping the read would have pinned anyone
         who had ever pressed the old toggle to that choice permanently, with no
         control left to change it back. The OS preference is now the only
         input, which is also the answer most people want. -->
    <script is:inline>
      (() => {
        const dark = matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", dark);
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute("content", dark ? "#121212" : "#ffffff");
      })();
    </script>
  </head>

  <body>
    <!-- Top margin matches the page's internal section rhythm (48px). Outer
         spacing tighter than inner spacing always reads as cramped.
         `.page` owns the horizontal padding and draws the continuous rail. -->
    <div
      class:list={[
        "page mx-auto max-w-[44rem] pb-8",
        !reading && rail && "page-rail",
      ]}
    >
      <!-- Just the name. No mark, no nav, no band.
           24px, which abandons the flat two-size scale on purpose: 16px
           semibold was tried and it read as timid rather than restrained. A
           page needs a face. Tracking goes negative as the size grows —
           large type reads too loose at the tracking small type needs — and
           leading tightens to match. -->
      <header
        class:list={[
          "rail",
          divider && "border-b border-ui1 pb-3",
          reading && "rail-seg",
        ]}
        style={reading ? "--seg-top: var(--page-top)" : undefined}
      >
        <span aria-hidden="true"></span>
        <a href="/" class="block w-fit">
          <Masthead
            class="block text-2xl font-semibold leading-tight tracking-[-0.02em]"
          >
            Sam McClenaghan
          </Masthead>
        </a>
      </header>

      <!-- 20px, deliberately not 12px. The lede's own paragraphs sit 12px
           apart, so matching that made the name read as another line of the
           paragraph instead of the head of the block. Distinct levels need
           distinct gaps — but still well under the 48px that separates
           blocks, so name and lede stay one unit. -->
      <main class:list={[divider ? "pt-[var(--head-gap)]" : "pt-6"]}>
        <slot />
      </main>

      <!-- Everything that used to be a navbar, moved below the content. -->
      <footer class="rail border-t border-ui1 mt-16 pt-3">
        <span aria-hidden="true"></span>
        <div class="meta flex flex-wrap gap-x-4 gap-y-1">
          {
            links.map((item) => (
              <a
                href={item.href}
                data-link
                target={item.href.startsWith("http") ? "_blank" : undefined}
                rel={
                  item.href.startsWith("http")
                    ? "noopener noreferrer"
                    : undefined
                }
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </footer>
    </div>
  </body>
</html>
