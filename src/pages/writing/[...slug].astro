---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async () => {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);

const formatted = post.data.date.toLocaleDateString("en-US", {
  month: "short",
  year: "numeric",
});
---

<Layout
  title={post.data.title}
  description={post.data.description}
  math={post.data.math}
  published={post.data.date}
  reading
>
  <article>
    <div class="rail rail-seg pb-8" style="--seg-top: var(--head-gap)">
      <time
        class="meta rail-date pt-1.5"
        datetime={post.data.date.toISOString().slice(0, 10)}
      >
        {formatted}
      </time>
      <h1
        class="max-w-[34rem] text-2xl font-semibold leading-tight tracking-[-0.02em]"
      >
        {post.data.title}
      </h1>
    </div>

    <div class="rail">
      <span aria-hidden="true"></span>
      <div class="max-w-[34rem]">
        <div class="prose">
          <Content />
        </div>

        <a href="/" data-link class="meta mt-12 inline-block">← index</a>
      </div>
    </div>
  </article>
</Layout>
