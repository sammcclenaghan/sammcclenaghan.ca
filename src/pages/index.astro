---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { projects } from "../data/projects";

// Everything on one page. No /writing index, no /projects index — the only
// other pages that exist are the posts themselves.
const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// One clause per role. The rows carried only company/title/year, which proves
// a job was held, not that it went well — and this is the section a recruiter
// actually reads. Lifted from Sam's own resume, so the claims are his.
const work = [
  {
    company: "Vertical City",
    role: "Software Engineer Intern",
    years: "2026 —",
    note: "Built an in-house video ad pipeline on AWS, replacing a paid third-party service.",
  },
  {
    company: "Leanpub",
    role: "Full Stack Developer Intern",
    years: "2025",
    note: "Rebuilt the Dropbox integration and background job progress tracking on a large Rails monolith.",
  },
  {
    company: "Trustscience",
    role: "Application & APIs Developer Intern",
    years: "2024",
    note: "A file version-control system using delta storage, and a real-time financial analytics platform.",
  },
  {
    company: "Trustscience",
    role: "Frontend Developer Intern",
    years: "2022 — 23",
    note: "Modernized the frontend with Vue 3 and serverless Lambda services.",
  },
];
---

<Layout>
  <!-- Below the rule, not above it: the name is the masthead and the rule
       closes it, so the description reads as the first piece of content rather
       than part of the letterhead.
       The -16px pulls it to 24px under the rule against 56px below, so it
       clearly attaches upward instead of floating between two sections — it
       sat at 40/56 before, near-symmetrical, which grouped it with nothing.
       Done here rather than on main's padding because posts need that value
       to stay at --head-gap: the rail stroke segments measure against it. -->
  <!-- Labelled like every other section. It was the one block on the page with
       an empty gutter cell, on a page where the gutter always carries a marker
       — so it read as an orphan regardless of its size. With a label the index
       is four consistent sections: now / writing / projects / work. -->
  <section id="about" class="-mt-4 space-y-2 pb-14">
    <div class="rail">
      <h2 class="meta rail-label">now</h2>
      <span aria-hidden="true"></span>
    </div>

    <!-- Body size and body leading, inherited — no overrides. Now that the
         section carries a label like every other one, it doesn't need type
         size to mark itself out as different. -->
    <div class="rail">
      <span aria-hidden="true"></span>
      <div class="max-w-[34rem] space-y-3">
        <p>
          I'm a computer science student at the University of Victoria, where
          I'm the director of projects at VikeLabs. I'm also currently interning
          at Vertical City, where I write Ruby that handles billions of
          requests.
        </p>
        <p>
          I love diving into weird, hard problems and making them feel simple.
          When I'm not coding, I'm usually playing disc golf or watching the
          Montreal Canadiens.
        </p>
      </div>
    </div>
  </section>

  <!-- Each row is one <a> that is itself the rail grid, so the date and the
       text are inside a single hover target and a single click target. They
       used to be two loose cells in the section's grid, which meant only the
       title was clickable and nothing could highlight the row as a whole. -->
  <section id="writing" class="space-y-2 pb-14">
    <div class="rail">
      <h2 class="meta rail-label">writing</h2>
      <span aria-hidden="true"></span>
    </div>

    {
      posts.map((post) => (
        <a href={`/writing/${post.id}`} class="rail row">
          <time
            class="meta rail-date pt-px"
            datetime={post.data.date.toISOString().slice(0, 10)}
          >
            {post.data.date.getFullYear()}
          </time>
          <div class="max-w-[34rem]">
            <span class="block font-medium">{post.data.title}</span>
            {post.data.description && (
              <span class="block text-tx2">{post.data.description}</span>
            )}
          </div>
        </a>
      ))
    }
  </section>

  <section id="projects" class="space-y-2 pb-14">
    <div class="rail">
      <h2 class="meta rail-label">projects</h2>
      <span aria-hidden="true"></span>
    </div>

    {
      projects.map((project) => (
        <a
          href={project.href}
          target="_blank"
          rel="noopener noreferrer"
          class="rail row"
        >
          <span class="meta rail-date pt-px">{project.year}</span>
          <div class="max-w-[34rem]">
            <span class="block font-medium">{project.name}</span>
            <span class="block text-tx2">{project.description}</span>
          </div>
        </a>
      ))
    }
  </section>

  <section id="work" class="space-y-2">
    <div class="rail">
      <h2 class="meta rail-label">work</h2>
      <span aria-hidden="true"></span>
    </div>

    {
      work.map((job) => (
        <div class="rail row">
          <span class="meta rail-date pt-px">{job.years}</span>
          <div class="max-w-[34rem]">
            <span class="block font-medium">{job.company}</span>
            <span class="block text-tx2">{job.role}</span>
            <span class="block text-tx2">{job.note}</span>
          </div>
        </div>
      ))
    }
  </section>
</Layout>
