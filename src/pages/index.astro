---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { projects } from "../data/projects";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const work = [
  {
    company: "Vertical City",
    role: "Software Engineer Intern",
    years: "2026 —",
    note: "Bringing video ad processing in-house, off a paid vendor.",
  },
  {
    company: "Leanpub",
    role: "Full Stack Developer Intern",
    years: "2025",
    note: "Rebuilt how authors sync files and follow long-running jobs.",
  },
  {
    company: "Trust Science",
    role: "Application & APIs Developer Intern",
    years: "2024",
    note: "Built backend services for file history and live financial data.",
  },
  {
    company: "Trust Science",
    role: "Frontend Developer Intern",
    years: "2022 — 23",
    note: "Modernized the frontend and moved its services to serverless.",
  },
];
---

<Layout>
  <section id="about" class="-mt-4 space-y-2 pb-14">
    <div class="rail">
      <h2 class="meta rail-label">now</h2>
      <span aria-hidden="true"></span>
    </div>

    <div class="rail">
      <span aria-hidden="true"></span>
      <div class="max-w-[34rem] space-y-3">
        <p>
          I'm a computer science student at the University of Victoria, where
          I'm the director of projects at <a
            href="https://www.vikelabs.ca"
            target="_blank"
            rel="noopener noreferrer"
            class="link">VikeLabs</a
          >. I'm also currently interning at <a
            href="https://www.verticalcity.com"
            target="_blank"
            rel="noopener noreferrer"
            class="link">Vertical City</a
          >, where I write Ruby that handles billions of requests.
        </p>
        <p>
          I love diving into weird, hard problems and making them feel simple.
          When I'm not coding, I'm usually playing disc golf or watching the
          Montreal Canadiens.
        </p>
      </div>
    </div>
  </section>

  <section id="writing" class="space-y-2 pb-14">
    <div class="rail">
      <h2 class="meta rail-label">writing</h2>
      <span aria-hidden="true"></span>
    </div>

    {
      posts.map((post) => (
        <a href={`/writing/${post.id}`} class="rail row">
          <time
            class="meta rail-date pt-px"
            datetime={post.data.date.toISOString().slice(0, 10)}
          >
            {post.data.date.getFullYear()}
          </time>
          <div class="max-w-[34rem]">
            <span class="block font-medium">{post.data.title}</span>
            {post.data.description && (
              <span class="block text-tx2">{post.data.description}</span>
            )}
          </div>
        </a>
      ))
    }
  </section>

  <section id="projects" class="space-y-2 pb-14">
    <div class="rail">
      <h2 class="meta rail-label">projects</h2>
      <span aria-hidden="true"></span>
    </div>

    {
      projects.map((project) => (
        <a
          href={project.href}
          target="_blank"
          rel="noopener noreferrer"
          class="rail row"
        >
          <span class="meta rail-date pt-px">{project.year}</span>
          <div class="max-w-[34rem]">
            <span class="block font-medium">{project.name}</span>
            <span class="block text-tx2">{project.description}</span>
          </div>
        </a>
      ))
    }
  </section>

  <section id="work" class="space-y-2">
    <div class="rail">
      <h2 class="meta rail-label">work</h2>
      <span aria-hidden="true"></span>
    </div>

    {
      work.map((job) => (
        <div class="rail row">
          <span class="meta rail-date pt-px">{job.years}</span>
          <div class="max-w-[34rem]">
            <span class="block font-medium">{job.company}</span>
            <span class="block text-tx2">{job.role}</span>
            <span class="block text-tx2">{job.note}</span>
          </div>
        </div>
      ))
    }
  </section>
</Layout>
