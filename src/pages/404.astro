---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404" description="That page doesn't exist.">
  <section class="space-y-2">
    <div class="rail">
      <h1 class="meta rail-label">404</h1>
      <span aria-hidden="true"></span>
    </div>

    <div class="rail">
      <span aria-hidden="true"></span>
      <div class="max-w-[34rem]">
        <p>This page doesn't exist.</p>
        <a href="/" data-link class="meta mt-6 inline-block">← index</a>
      </div>
    </div>
  </section>
</Layout>
