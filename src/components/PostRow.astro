---
type Props = {
  href: string;
  title: string;
  date: Date;
  /** The post's claim. Shown on the home page so someone scanning
      collects a few opinions before clicking anything. Left off /writing,
      where the list is long and titles alone scan faster. */
  description?: string;
};

const { href, title, date, description } = Astro.props;

const formatted = date.toLocaleDateString("en-US", {
  month: "short",
  year: "numeric",
});
---

<li class="animate">
  <a href={href} class="group block space-y-1 py-1">
    <span
      class="text-item font-medium block group-hover:text-accent transition-colors duration-200"
    >
      {title}
    </span>
    {
      description && (
        <p class="text-sm text-muted-foreground leading-relaxed">
          {description}
        </p>
      )
    }
    <time class="meta block" datetime={date.toISOString().slice(0, 10)}>
      {formatted}
    </time>
  </a>
</li>
